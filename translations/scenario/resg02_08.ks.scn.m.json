: {"disp": 2, "imageFile": {"file": "resg_bg059a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "いくつも並ぶパーツショップ、その店主のおっさんたちによる無言のプレッシャーに耐えながら辛抱強く探してみたものの……。", 58], [null, "Aku telusuri baris demi baris di toko part demi toko part, menanggung tekanan diam dari penjaga tua saat mereka menatapku...", 124], [null, "我在好幾家零件店間來回穿梭，忍受著大叔店長們無言的壓力，耐心地搜尋……", 35], [null, "走过一家又一家的零件店，忍受着店长们的无言压力，耐心地寻找了一阵子……", 35]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm05", "loop": 1, "start": null, "state": 1, "volume": 62.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg059a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "まったく成果はなく。", 10], [null, "Sayang, tidak beruntung.", 24], [null, "然而什麼收穫都沒有。", 10], [null, "结果什么都没找到。", 9]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm05", "loop": 1, "start": null, "state": 1, "volume": 62.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg059a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "ずっと歩き回っていたせいか、腹が減った……。よく考えたら朝からなにも食べていない。", 41], [null, "Aku cepat sadar aku belum makan sejak pagi... Dan aku lebih dari kelaparan.", 75], [null, "可能是走了太久了，肚子開始餓了起來。仔細想想，從早上到現在什麼都沒吃。", 35], [null, "大概是走了太久，肚子开始饿了……仔细一想，我从早上到现在什么也没吃。", 34]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm05", "loop": 1, "start": null, "state": 1, "volume": 62.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg059a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "……サンポでも行くか。", 11], [null, "...Mungkin aku ke Sanpo.", 24], [null, "……去Sanpo吧。", 10], [null, "……还是去吃Sanpo吧。", 13]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm05", "loop": 1, "start": null, "state": 1, "volume": 62.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg059a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "うう〜む……。", 7], [null, "Hmmm...", 7], [null, "唔～嗯……", 5], [null, "唔……", 3]], null, 208, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm05", "loop": 1, "start": null, "state": 1, "volume": 62.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg058a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "牛丼をかきこみながら、ＩＢＮ５１００がどこにありそうか考えてみたが、まるで思いつかない。", 44], [null, "Saat aku melahap beef bowl-ku, aku coba pikirkan tiap tempat di mana IBN 5100 bisa berada, tapi tidak terpikir.", 111], [null, "我一邊扒著牛丼一邊思考著可能會有IBN5100的地方，但思來想去卻毫無頭緒。", 38], [null, "我边大口吃着牛肉盖饭，边思考着哪里可能会有IBN5100，但完全没有头绪。", 37]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm05", "loop": 1, "start": null, "state": 1, "volume": 62.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg058a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "ケータイの着信音に気が付いたマダムが、ジロリと俺の方を見た。", 30], [null, "Manajer melotot padaku saat ponselku berbunyi.", 46], [null, "聽見手機鈴聲響起，女老闆瞥了我一眼。", 18], [null, "这时响起了手机铃声，旁边的女老板瞪了我一眼。", 22]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm05", "loop": 1, "start": null, "state": 1, "volume": 62.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg058a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "俺はその視線に気が付かないふりをしつつ%p-1;─%p;─", 21], [null, "Aku pura tidak sadar...", 23], [null, "我假裝沒注意到她的視線，接起了來電。", 18], [null, "我假装没看到她的目光%p-1;—%p;—", 12, "我假装没看到她的目光——", "我假装没看到她的目光——"]], null, 128, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm05", "loop": 1, "start": null, "state": 1, "volume": 62.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg058a1", "options": {"resolution": 150}}, 