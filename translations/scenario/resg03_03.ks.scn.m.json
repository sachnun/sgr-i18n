rt": null, "state": 1, "volume": 42.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg003a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "その間、一度も失敗することはなく、すべてのＤメールは時間を遡った。", 33], [null, "Selama itu, tiap D-Mail kembali waktu tanpa hambatan.", 53], [null, "其中，一次也不曾失敗過。所有的D郵件都成功地回溯到了過去。", 29], [null, "在这段时间内，没有一次失败，所有的Dmail都发到了过去。", 29]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm13", "loop": 1, "start": null, "state": 1, "volume": 42.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg003a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "さすがに腹が減ってきたし、まゆり以外は全員徹夜組だったため、休憩を取ることになった。", 42], [null, "Kini waktunya istirahat. Kami semua lapar, dan kecuali Mayuri, kami begadang sejak tadi malam.", 94], [null, "因為肚子餓了，而且除了真由里以外的成員都是通宵的，所以我們決定稍作休息。", 36], [null, "因为大家都饿了，加上除了真由理以外所有人都是彻夜未眠，于是决定先休息一下。", 37]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm13", "loop": 1, "start": null, "state": 1, "volume": 42.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg003a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], ["紅莉栖", [[null, "どうぞ休んでて。私はもうちょっとやってみるから", 23], ["紅莉栖", "\"Silakan istirahat. Aku akan coba sedikit lebih lama.\"", 54], ["紅莉栖", "「你們先休息吧。我想再多試一下」", 16], ["紅莉栖", "“你们先休息吧。我再稍微弄一会儿”", 17]], [{"labels": [0, "vlstart", 235, "vlstop"], "name": "紅莉栖", "pan": 0, "time": 3919, "type": 0, "voice": "reSG03_03_KRS0000", "vols": [0.0, 0.0, 0.0, 0.190249537300503, 0.749267208773363, 0.749267208773363, 2.45721917259048, 3.45246442900044, 4.39089911178817, 5.1686263751016, 5.74005421737496, 6.07625879043192, 6.18077505293084, 6.09435656491027, 5.86191575238989, 5.52289957980709, 5.00560759744306, 4.40087773582317, 3.81741932744908, 3.36945091002746, 3.12075810934711, 3.06787373116089, 3.17465131595705, 3.39739319620081, 3.68685593550314, 4.0045683633732, 4.2994393866145, 4.52462485260761, 4.61439057063166, 4.49903216558153, 4.27771642187195, 4.02134808197124, 3.75898799962474, 3.53850563758909, 3.36088864726148, 3.16815032597769, 3.16279243211239, 3.30153166619909, 3.51410724652173, 3.78835944522275, 4.04020521251642, 4.24403446576021, 4.38167767558309, 4.39122041692507, 4.33725912221797, 4.3185533943711, 4.29664069906442, 4.1655826767726, 3.80149601310988, 3.25652255075611, 2.56649177484364, 1.94291004954706, 1.56242502910206, 1.515