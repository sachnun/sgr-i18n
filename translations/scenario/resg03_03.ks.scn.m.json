isp": 2, "imageFile": {"file": "resg_bg003a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}], ["紅莉栖", "character", {"action": [["leveloffset", "#0,0,0,-150,0,-350,0,0"], ["zpos", 56.25]], "class": "character", "name": "紅莉栖", "redraw": {"disp": 2, "imageFile": {"file": "牧瀬紅莉栖ab_白衣.psb", "options": {"color": 7631991, "lang": "ja", "slot0": "表情_普通", "slot2": "笑い"}}, "posName": "出"}, "showmode": 3, "type": null}]], "env": {"action": [["camerazoom", 125]], "name": "env"}, "msgwin": 0}], [null, [[null, "やはり研究者としての血が騒ぐのかもしれない。", 22], [null, "Darah ilmuwannya pasti menyala.", 31], [null, "我想她身為一個研究者，對於這樣的事情是感到興奮的吧。", 26], [null, "果然是作为研究者的血液沸腾了吗。", 16]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm13", "loop": 1, "start": null, "state": 1, "volume": 42.4}, "update": {"state": 1}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg003a1", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}], ["紅莉栖", "character", {"action": [["leveloffset", "#0,0,0,-150,0,-350,0,0"], ["zpos", 56.25]], "class": "character", "name": "紅莉栖", "showmode": 0, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "色々と分かってきたことはあるが、議論についてはひとまず後にして、腹ごしらえだ。", 39], [null, "Kami telah buat sejumlah penemuan, tapi kita bisa tunggu nilai mereka sampai setelah makan.", 91], [null, "我們漸漸知道了一些事情，不過留著晚點再討論。先吃點東西吧。", 29], [null, "虽然已经掌握了不少东西，但讨论的事暂且放一边，先填饱肚子再说。", 31]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": "bgm13", "loop": 1, "st