e": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "そんな予測を元に、先にそちらへ行ってみたが、神社の関係者からはそんな話は聞いたことがないと言われてしまった。", 54], [null, "Tapi saat aku tanya di kantor kuil, tak ada yang tahu soal komputer tua.", 72], [null, "根據這樣的預測，我決定先到神田明神看看。但神社的人卻說沒聽說過這件事。", 35], [null, "根据这种推测，我先去了那边，但神社的相关人员却告诉我没听过有那么回事。", 35]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": null, "loop": null, "start": null, "state": null, "volume": null}, "update": {"state": null}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg054a1_mob", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "やむなく柳林神社へ向かう。", 13], [null, "Itu tinggalkan Kuil Yanabayashi.", 32], [null, "沒辦法。只好到柳林神社看看。", 14], [null, "无奈只好又前往柳林神社。", 12]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": null, "loop": null, "start": null, "state": null, "volume": null}, "update": {"state": null}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg054a1_mob", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "どうせそこも外れだろうが……。", 15], [null, "Mungkin tidak ada di sana juga, tapi aku harus coba.", 52], [null, "但是八成也是白跑一趟……", 12], [null, "虽说这边估计也没什么希望……", 14]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": null, "loop": null, "start": null, "state": null, "volume": null}, "update": {"state": null}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg054a1_mob", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "type": null}]], "env": {"name": "env"}, "msgwin": 0}], [null, [[null, "となると、都内の神社を１つずつしらみ潰しに探していくしか手はないかもしれん。", 38], [null, "Kalau itu gagal, aku harus cari semua kuil Tokyo satu per satu.", 63], [null, "這樣一來，可能就要一間一間慢慢找遍全東京的神社了。", 25], [null, "这样一来，或许只能在市内一座一座神社挨着找了。", 23]], null, 192, {"data": [["bgm", "bgm", {"name": "bgm", "replay": {"filename": null, "loop": null, "start": null, "state": null, "volume": null}, "update": {"state": null}}], ["subwin", "subwin_info", {"action": [["originz", -500], ["$progress", -1]], "class": "subwin_info", "name": "subwin", "redraw": {"disp": 2, "imageFile": {"file": "subwindow.mtn", "options": {"chara": "SUBWIN", "motion": "progress", "speed": 1.0, "tickcount": 0.0, "variables": {"progress": -1.0}}}, "posName": null}, "showmode": 3, "type": null}], ["bg", "stage", {"action": [["zpos", 233.33333333333337]], "class": "stage", "name": "bg", "redraw": {"disp": 2, "imageFile": {"file": "resg_bg054a1_mob", "options": {"resolution": 150}}, "posName": null}, "showmode": 3, "typ